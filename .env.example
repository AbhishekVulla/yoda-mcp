# Copy to .env and fill in. Never commit the real .env.

# MCP endpoint from the xiaozhi.me console ("Get MCP Endpoint"). SECRET.
# The MCP server dials OUT to this, so no port forwarding is needed.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN_HERE

# Neon Postgres. Shared by the MCP server and the dashboard. SECRET.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Where the senior profile lives: "neon" (shared DB) or "local" (data/profiles/*.json).
# "local" needs no database and is the offline fallback.
KB_BACKEND=neon

# Shared secret the necklace sends on every relay poll and frame push.
# Any random hex string, must match the dashboard's DEVICE_TOKEN.
DEVICE_TOKEN=generate_a_random_hex_string

# Seconds an open health check may sit before silence is treated as an emergency.
EMERGENCY_TIMEOUT_S=25
