# Copy to .env.local and fill in. Never commit the real .env.local.

# Same Neon database the MCP server writes to. SECRET.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Used server-side only, to synthesize the SBAR clinical handover. SECRET.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Must match the DEVICE_TOKEN in the MCP server's .env, so only the
# necklace can poll for commands and push camera frames.
DEVICE_TOKEN=generate_a_random_hex_string
